{"model":"claude-sonnet-5-5","goal":"Prepare an evidence-limited inspection handoff. The numerical acceptance interval is [12.48,12.52] mm, inclusive. Interval inclusion is arithmetic only, not physical validation.","ops":{"fields":"Return a compact JSON array of strings containing the reference's length, uncertainty, n, method, basis, physical_validation, in that order, preserving field values exactly.","interval":"Return a compact JSON array [length-uncertainty,length+uncertainty], each formatted as a string with two decimal places and unit mm. If uncertainty is unknown, return unknown.","unknowns":"Return a compact JSON array of field names whose values are unknown, in this order: uncertainty, method, basis.","inside":"Return inside if the entire length +/- uncertainty interval lies within the goal's acceptance interval; outside otherwise. If uncertainty is unknown, return unknown."},"refs":{"1":{"path":"refs/1.txt"},"2":{"path":"refs/2.txt"},"3":{"path":"refs/3.txt"},"4":{"path":"refs/4.txt"},"5":{"path":"refs/5.txt"},"6":{"path":"refs/6.txt"},"7":{"path":"refs/7.txt"},"8":{"path":"refs/8.txt"},"9":{"path":"refs/9.txt"},"10":{"path":"refs/10.txt"},"11":{"path":"refs/11.txt"},"12":{"path":"refs/12.txt"},"13":{"path":"refs/13.txt"},"14":{"path":"refs/14.txt"},"15":{"path":"refs/15.txt"},"16":{"path":"refs/16.txt"}},"jobs":[["ma_01","fields","1"],["ma_02","interval","1"],["ma_03","unknowns","1"],["ma_04","inside","1"],["ma_05","fields","2"],["ma_06","interval","2"],["ma_07","unknowns","2"],["ma_08","inside","2"],["ma_09","fields","3"],["ma_10","interval","3"],["ma_11","unknowns","3"],["ma_12","inside","3"],["ma_13","fields","4"],["ma_14","interval","4"],["ma_15","unknowns","4"],["ma_16","inside","4"],["ma_17","fields","5"],["ma_18","interval","5"],["ma_19","unknowns","5"],["ma_20","inside","5"],["ma_21","fields","6"],["ma_22","interval","6"],["ma_23","unknowns","6"],["ma_24","inside","6"],["ma_25","fields","7"],["ma_26","interval","7"],["ma_27","unknowns","7"],["ma