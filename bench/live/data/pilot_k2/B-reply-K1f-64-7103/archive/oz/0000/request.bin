{"model":"claude-sonnet-5-5","goal":"Prepare an evidence-limited inspection handoff. The numerical acceptance interval is [12.48,12.52] mm, inclusive. Interval inclusion is arithmetic only, not physical validation.","ops":{"fields":"Return a compact JSON array of strings containing the reference's length, uncertainty, n, method, basis, physical_validation, in that order, preserving field values exactly.","bounds":"Return a compact JSON array [length-uncertainty,length+uncertainty], each formatted as a string with two decimal places and unit mm. If uncertainty is unknown, return unknown.","unk":"Return a compact JSON array of field names whose values are unknown, in this order: uncertainty, method, basis.","inside":"Return inside if the entire length +/- uncertainty interval lies within the acceptance interval [12.48,12.52] mm inclusive; outside otherwise. If uncertainty is unknown, return unknown."},"refs":{"r1":{"path":"refs/1.txt"},"r2":{"path":"refs/2.txt"},"r3":{"path":"refs/3.txt"},"r4":{"path":"refs/4.txt"},"r5":{"path":"refs/5.txt"},"r6":{"path":"refs/6.txt"},"r7":{"path":"refs/7.txt"},"r8":{"path":"refs/8.txt"},"r9":{"path":"refs/9.txt"},"r10":{"path":"refs/10.txt"},"r11":{"path":"refs/11.txt"},"r12":{"path":"refs/12.txt"},"r13":{"path":"refs/13.txt"},"r14":{"path":"refs/14.txt"},"r15":{"path":"refs/15.txt"},"r16":{"path":"refs/16.txt"}},"jobs":[["ma_01","fields","r1"],["ma_02","bounds","r1"],["ma_03","unk","r1"],["ma_04","inside","r1"],["ma_05","fields","r2"],["ma_06","bounds","r2"],["ma_07","unk","r2"],["ma_08","inside","r2"],["ma_09","fields","r3"],["ma_10","bounds","r3"],["ma_11","unk","r3"],["ma_12","inside","r3"],["ma_13","fields","r4"],["ma_14","bounds","r4"],["ma_15","unk","r4"],["ma_16","inside","r4"],["ma_17","fields","r5"],["ma_18","bounds","r5"],["ma_19","unk","r5"],["ma_20","inside","r5"],["ma_21","fields","r6"],["ma_22","bounds","r6"],["ma_23","unk","r6"],["ma_24","inside","r6"],["ma_25","fields","r7"],["ma_26","bounds","r7"],["ma_27","unk","r7