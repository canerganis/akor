{
 "policy": "o1-ast-policy/1",
 "max_source_bytes": 4096,
 "max_module_bytes": 32768,
 "nodes": ["Module", "FunctionDef", "arguments", "arg", "Return", "Delete", "Assign", "AugAssign", "For", "While",
           "If", "Raise", "Try", "ExceptHandler", "Assert", "Expr", "Pass", "Break", "Continue", "BoolOp", "NamedExpr",
           "BinOp", "UnaryOp", "Lambda", "IfExp", "Dict", "Set", "ListComp", "SetComp", "DictComp", "GeneratorExp",
           "Compare", "Call", "keyword", "FormattedValue", "JoinedStr", "Constant", "Attribute", "Subscript",
           "Starred", "Name", "List", "Tuple", "Slice", "comprehension", "Load", "Store", "Del", "And", "Or", "Add",
           "Sub", "Mult", "Div", "FloorDiv", "Mod", "Pow", "LShift", "RShift", "BitOr", "BitXor", "BitAnd", "Invert",
           "Not", "UAdd", "USub", "Eq", "NotEq", "Lt", "LtE", "Gt", "GtE", "Is", "IsNot", "In", "NotIn"],
 "builtins": ["abs", "all", "any", "bool", "dict", "divmod", "enumerate", "filter", "float", "int", "isinstance",
              "len", "list", "map", "max", "min", "range", "reversed", "round", "set", "sorted", "str", "sum", "tuple",
              "zip", "ArithmeticError", "Exception", "IndexError", "KeyError", "LookupError", "OverflowError",
              "RecursionError", "TypeError", "ValueError", "ZeroDivisionError", "None", "True", "False"],
 "methods": ["append", "copy", "count", "endswith", "extend", "find", "get", "index", "insert", "isascii", "isdecimal",
             "isdigit", "items", "join", "keys", "lower", "lstrip", "partition", "pop", "remove", "replace", "reverse",
             "rfind", "rjust", "rpartition", "rsplit", "rstrip", "setdefault", "sort", "split", "startswith", "strip",
             "update", "upper", "values", "zfill", "add", "discard", "difference", "intersection", "union", "issubset",
             "ljust", "clear"],
 "forbidden_names": ["getattr", "setattr", "delattr", "hasattr", "type", "vars", "globals", "locals", "eval", "exec",
                     "compile", "open", "input", "breakpoint", "memoryview", "object", "super", "dir", "id", "help",
                     "exit", "quit", "classmethod", "staticmethod", "property", "print", "iter", "next", "callable",
                     "format", "repr", "ascii", "chr", "ord", "bytes", "bytearray", "frozenset", "issubclass",
                     "slice", "hash", "pow", "aiter", "anext", "license", "credits", "copyright"],
 "refused_forms": "imports, decorators, annotations, global, nonlocal, yield, await, async, with, class, match, star-args, keyword-only parameters, defaults, names or attributes starting with an underscore, attributes outside the method list",
 "comparison": "outputs are canonical type-strict JSON (None, bool, int, str, list, object with string keys); tuples, sets and floats are unsupported outputs and fail the row; exceptions compare by exact class name",
 "seeds": [0, 1],
 "limits": {"process_memory_bytes": 268435456, "active_processes": 1, "cpu_seconds": 2.0, "wall_seconds": 5.0}
}
