      }
     }
    },
    {
     "a": {
      "b": {
       "c": null
      }
     }
    }
   ],
   "expect": {
    "r": "{\"a\":{\"b\":{\"d\":2}}}"
   }
  },
  {
   "id": "I.C1.05",
