      "patch": {
       "srv": {
        "port": 8080
       }
      }
     }
    ]
   ],
   "expect": {
    "r": "{\"srv\":{\"port\":8080,\"tls\":true}}"
   }
  },
  {
   "id": "I.C1.01",
   "fn": "apply_revisions",
   "args": [
    {
     "a": [
      1,
      2
     ]
    },
    [
     {
      "seq": 1,
      "patch": {
       "a": null,
       "b": [
        0
       ]
      }
     }
    ]
   ],
   "expect": {
    "r": "{\"b\":[0]}"
   }
  },
  {
   "id": "I.C1.02",
   "fn": "apply_revisions",
   "args": [
    {},
    [
     {
      "seq": 2,
      "patch": {
       "x": {
        "y": {
         "z": 1
        }
       }
      }
     },
     {
      "seq": 1,
      "patch": {
       "x": 0
      }
     }
    ]
   ],
   "expect": {
    "r": "{\"x\":{\"y\":{\"z\":1}}}"
   }
  },
  {
   "id": "I.C1.03",
   "fn": "apply_revisions",
   "args": [
