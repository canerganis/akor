+class InputPolicyTests(unittest.TestCase):
+    """oz-rule/1 amendment 1, D2: the opt-in input policy (default absent = literal, byte-identical)."""
+    POLICY = 'strip-one-terminal-newline/1'
+
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.root = DoTests.space(self, Path(temp.name) / 'ws')
+
+    def run_do(self, req):
+        return do(req, workspace=self.root, adapter=self.root / 'adapter.json')
+
+    def norm(self, **extra):
+        from oz_do import normalize
+        from oz_workspace import Workspace
+        req = {'request_id': 'pol', 'goal': 'g', 'ops': {'o': 'Do it.'}, 'refs': {'c': {'path': 'f.txt'}},
+               'jobs': [['j1', 'o', 'c']], **extra}
+        return normalize(req, allow=self.root, config=Workspace(self.root).config)
+
+    def put(self, data):
+        (self.root / 'f.txt').write_bytes(data)
+
+    def test_default_request_is_literal_and_keeps_its_identity(self):
+        self.put(b'length=12.50 mm\n')
+        plain = self.norm()
+        self.assertEqual(plain['texts']['c']['text'], 'length=12.50 mm\n')
+        self.assertNotIn('input_policy', plain['work'])
+        self.assertNotIn('inputs', plain['work'])
+        self.assertEqual(plain['inputs'], {})
+        again = self.norm()
+        self.assertEqual(plain['sha256'], again['sha256'])
+
+    def test_exactly_one_terminal_crlf_else_one_lf_is_removed_and_nothing_else(self):
+        for raw, kept, removed in ((b'a\n', 'a', '\n'), (b'a\r\n', 'a', '\r\n'), (b'a\n\n', 'a\n', '\n'),
+                                   (b'a\r\n\r\n', 'a\r\n', '\r\n'), (b'a\r', 'a\r', ''), (b'a', 'a', ''),
+                                   (b'a\n\r\n', 'a\n', '\r\n'), (b'  a  \n', '  a  ', '\n'),
+                                   (b'a\nb\n', 'a\nb', '\n')):
+            self.put(raw)
+            got = self.norm(input_policy=self.POLICY)
+            self.assertEqual(got['texts']['c']['text'], kept, raw)
+            receipt = got['inputs']['c']
+            self.assertEqual((receipt['removed'], receipt['policy']), (removed, self.POLICY), raw)
+            self.assertEqual(receipt['raw_sha256'], __import__('hashlib').sha256(raw).hexdigest())
+            self.assertEqual(receipt['resolved_sha256'], __import__('hashlib').sha256(kept.encode()).hexdigest())
+
+    def test_the_policy_and_raw_bytes_are_part_of_the_work_identity(self):
+        self.put(b'v\n')
+        plain, strip = self.norm(), self.norm(input_policy=self.POLICY)
+        self.assertNotEqual(plain['sha256'], strip['sha256'])
+        self.put(b'v\r\n')
+        crlf = self.norm(input_policy=self.POLICY)
+        self.assertEqual(crlf['texts']['c']['text'], strip['texts']['c']['text'])
+        self.assertNotEqual(crlf['sha256'], strip['sha256'])  # different raw bytes, same resolved text
+
+    def test_a_file_that_is_only_a_newline_is_blank_after_the_policy(self):
+        self.put(b'\r\n')
+        with self.assertRaisesRegex(Error, 'nonblank'):
+            self.norm(input_policy=self.POLICY)
+
+    def test_policy_applies_to_file_refs_only_and_unknown_policies_are_refused(self):
+        from oz_do import normalize
+        from oz_workspace import Workspace
+        req = {'goal': 'g', 'ops': {'o': 'x'}, 'refs': {'c': 'inline\n'}, 'jobs': [['j1', 'o', 'c']],
+               'input_policy': self.POLICY}
+        got = normalize(req, allow=self.root, config=Workspace(self.root).config)
+        self.assertEqual(got['texts']['c']['text'], 'inline\n')
+        self.assertEqual(got['inputs'], {})
+        with self.assertRaisesRegex(Error, 'input_policy'):
+            self.norm(input_policy='trim/9')
+
+    def test_the_resolved_text_reaches_the_packet_and_the_result_reports_receipts(self):
+        self.put(b'length=12.50 mm\r\n')
+        req = {'request_id': 'pol1', 'goal': 'g', 'ops': {'o': 'Do it.'}, 'refs': {'c': {'path': 'f.txt'}},
+               'jobs': [['j1', 'o', 'c']], 'allow_experimental': True, 'max_input_tokens': 100000,
+               'input_policy': self.POLICY}
+        result = self.run_do(req)
+        self.assertEqual(result['jobs']['j1']['value'], ['Do it.', 'length=12.50 mm'])
+        self.assertEqual(result['inputs']['policy'], self.POLICY)
+        self.assertEqual(result['inputs']['refs']['c']['removed'], '\r\n')
+        # Without the policy the file text is literal and the result has no receipts.
+        literal = self.run_do({k: v for k, v in dict(req, request_id='pol2').items() if k != 'input_policy'})
+        self.assertEqual(literal['jobs']['j1']['value'], ['Do it.', 'length=12.50 mm\r\n'])
+        self.assertNotIn('inputs', literal)
+
+
+class RuleReceiptMemoTests(unittest.TestCase):
+    """Amendment D9: a rule receipt never enters memo storage."""
+
+    def test_memo_publish_skips_memo_and_rule_receipts(self):
+        from oz_do import _memo_publish
+
+        class Box:
+            def candidates(self, status=None):
+                return [{'receipt': r, 'job': 'j', 'compute_key': 'k', 'value': 'v', 'stored': 'v', 'checks': [],
+                         'verdicts': [], 'seq': i} for i, r in enumerate(('memo:7', 'rule:3', 'rcpt1'))]
+
+            def dispatch(self, receipt):
+                return {'route': {}}
+
+        class Store:
+            published = []
+
+            def publish(self, namespace, key, **kw):
+                self.published.append(kw['provenance']['receipt'])
+
+        store = Store()
+        _memo_publish(Box(), {'work': {'jobs': [['j', 'op']]}, 'request_id': 'r'}, Path('/w'), Path('/w/do/r'),
+                      {'store': store, 'namespace': 'n', 'ops': ['op']})
+        self.assertEqual(store.published, ['rcpt1'])
+
+
 if __name__ == '__main__':
     unittest.main()
